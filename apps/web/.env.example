DATABASE_URL="postgresql://restyle:restyle@localhost:5433/restyle"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public base URL QStash calls back into (worker endpoint). Locally the QStash dev server
# runs on this machine, so localhost works.
APP_URL="http://localhost:3000"

# Storage (S3 API): S3Mock locally, Cloudflare R2 in production
S3_ENDPOINT="http://localhost:9090"
S3_REGION="auto"
S3_BUCKET="restyle"
S3_ACCESS_KEY_ID="local"
S3_SECRET_ACCESS_KEY="local"

# Queue: local QStash dev server (`pnpm qstash:dev`). These are its fixed, publicly documented
# dev credentials, not secrets. Production values come from the Upstash console, never here.
QSTASH_URL="http://127.0.0.1:8180"
QSTASH_TOKEN="eyJVc2VySUQiOiJkZWZhdWx0VXNlciIsIlBhc3N3b3JkIjoiZGVmYXVsdFBhc3N3b3JkIn0="
QSTASH_CURRENT_SIGNING_KEY="sig_7kYjw48mhY7kAjqNGcy6cr29RJ6r"
QSTASH_NEXT_SIGNING_KEY="sig_5ZB6DVzB1wjE8S6rZ7eenA8Pdnhs"

# AI: "fake" tints the photo locally and costs nothing; "cloudflare" calls Workers AI
AI_PROVIDER="fake"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""

# Site-wide daily cap (ADR 0005). Per-person limits come from the plan (lib/entitlements.ts, ADR 0010)
GENERATION_LIMIT_DAILY="50"

# Accounts (Better Auth, ADR 0010): signs session cookies. Any long random string locally; in
# production generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="local-dev-secret-at-least-32-characters-long"

# Secret salt for hashing client IPs in rate limiting (ADR 0008). Any random string;
# in production generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SALT="local-dev-salt"
