DATABASE_URL="postgresql://restyle:restyle@localhost:5433/restyle"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public base URL QStash calls back into (worker endpoint). Locally the QStash dev server
# runs on this machine, so localhost works.
APP_URL="http://localhost:3000"

# Storage (S3 API): S3Mock locally, Cloudflare R2 in production
S3_ENDPOINT="http://localhost:9090"
S3_REGION="auto"
S3_BUCKET="restyle"
S3_ACCESS_KEY_ID="local"
S3_SECRET_ACCESS_KEY="local"

# Queue: local QStash dev server (`pnpm qstash:dev`, fixed documented dev credentials)
QSTASH_URL="http://127.0.0.1:8180"
QSTASH_TOKEN="<printed by pnpm qstash:dev>"
QSTASH_CURRENT_SIGNING_KEY="<printed by pnpm qstash:dev>"
QSTASH_NEXT_SIGNING_KEY="<printed by pnpm qstash:dev>"

# AI: "fake" tints the photo locally and costs nothing; "cloudflare" calls Workers AI
AI_PROVIDER="fake"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""

# Limits (ADR 0005): per visitor per day, and for the whole site per day
GENERATION_LIMIT_PER_VISITOR="5"
GENERATION_LIMIT_DAILY="50"
