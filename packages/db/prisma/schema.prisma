generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uk
  en
}

model Room {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  priority     Int               @default(0)
  translations RoomTranslation[]
  pages        IdeaPage[]
  updatedAt    DateTime          @updatedAt
}

model RoomTranslation {
  roomId Int
  locale Locale
  name   String
  intro  String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, locale])
}

model Style {
  id           Int                @id @default(autoincrement())
  slug         String             @unique
  priority     Int                @default(0)
  palette      String[]
  translations StyleTranslation[]
  pages        IdeaPage[]
  updatedAt    DateTime           @updatedAt
}

model StyleTranslation {
  styleId   Int
  locale    Locale
  name      String
  summary   String
  materials String[]
  style     Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([styleId, locale])
}

/// One programmatic landing page: room × style × locale.
/// A row exists only when the combination has enough unique content to be indexable.
model IdeaPage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  styleId   Int
  locale    Locale
  title     String
  lead      String
  tips      String[]
  faq       Json // [{ q: string, a: string }]
  published Boolean  @default(true)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  style     Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([roomId, styleId, locale])
  @@index([locale, published])
}

enum VitalName {
  LCP
  INP
  CLS
  FCP
  TTFB
}

enum FormFactor {
  mobile
  desktop
}

/// One Core Web Vitals sample from a real visitor (RUM). Lab runs and bots are dropped
/// by the API, so this table is field data only. Reported as p75 per route and metric.
model WebVital {
  id         BigInt     @id @default(autoincrement())
  /// web-vitals metric id; the same metric is re-reported each time the page is hidden,
  /// so reports keep only the latest row per metricId
  metricId   String?
  createdAt  DateTime   @default(now())
  name       VitalName
  value      Float // ms, except CLS (unitless)
  rating     String // good | needs-improvement | poor, as computed by web-vitals
  route      String // route template, e.g. /[locale]/ideas/[room]/[style]
  path       String // concrete URL path, for drilling into a single page
  navigation String // navigate | reload | back-forward | ...
  formFactor FormFactor
  /// Coarse browser family. Google ranks on CrUX (Chrome only, no iOS), and Safari measures
  /// INP differently, so reports keep browsers apart: chrome | edge | firefox | safari | ios | other
  browser    String     @default("other")
  /// INP only: what was interacted with and where the time went
  /// { event, target, startTime, inputDelay, processing, presentation }
  attribution Json?

  @@index([name, route, createdAt])
}

enum GenerationStatus {
  queued
  running
  done
  failed
}

/// One photo redesign job (ADR 0005). Created as `queued`, processed by the QStash worker.
model Generation {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  status      GenerationStatus @default(queued)
  /// Random id from a cookie; no personal data. Used for the per-visitor daily limit.
  visitorId   String
  /// Set when the visitor was signed in: limits then follow the account's plan (ADR 0010)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  locale      Locale
  roomSlug    String
  styleSlug   String
  inputKey    String
  outputKey   String?
  provider    String
  /// Prompt version from apps/web/src/lib/ai/prompt.ts, to compare versions on real jobs
  promptVersion String?
  attempts    Int              @default(0)
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// One request counted for IP rate limiting (ADR 0008). `key` is `<action>:<hmac of IP>`; raw
/// IPs are never stored. Rows older than two days are pruned opportunistically.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// Accounts (ADR 0010). Tables and fields follow Better Auth's core schema, which its Prisma
// adapter reads and writes; ids are generated by Better Auth.

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  /// Stripe customer, created on the first checkout (ADR 0011)
  stripeCustomerId String?      @unique
  sessions      Session[]
  accounts      Account[]
  generations   Generation[]
  subscriptions Subscription[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// A way to sign in: "credential" (email + scrypt password hash) or an OAuth provider.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Billing (ADR 0011). Stripe is the source of truth; these rows are a local copy kept in sync
// by webhooks, so a page or API route never waits on Stripe to know the plan.

/// Copy of a Stripe subscription. Always written from a freshly retrieved Subscription object,
/// never from the event payload, so webhook order does not matter.
model Subscription {
  /// Stripe subscription id (sub_…)
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// active | trialing | past_due | canceled | unpaid | incomplete | incomplete_expired | paused
  status            String
  priceId           String
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

/// Webhook events already processed. Stripe delivers at least once, so a repeat is skipped.
model StripeEvent {
  /// Stripe event id (evt_…)
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
