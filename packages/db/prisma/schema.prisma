generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uk
  en
}

model Room {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  priority     Int               @default(0)
  translations RoomTranslation[]
  pages        IdeaPage[]
  updatedAt    DateTime          @updatedAt
}

model RoomTranslation {
  roomId Int
  locale Locale
  name   String
  intro  String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, locale])
}

model Style {
  id           Int                @id @default(autoincrement())
  slug         String             @unique
  priority     Int                @default(0)
  palette      String[]
  translations StyleTranslation[]
  pages        IdeaPage[]
  updatedAt    DateTime           @updatedAt
}

model StyleTranslation {
  styleId   Int
  locale    Locale
  name      String
  summary   String
  materials String[]
  style     Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([styleId, locale])
}

/// One programmatic landing page: room × style × locale.
/// A row exists only when the combination has enough unique content to be indexable.
model IdeaPage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  styleId   Int
  locale    Locale
  title     String
  lead      String
  tips      String[]
  faq       Json // [{ q: string, a: string }]
  published Boolean  @default(true)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  style     Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([roomId, styleId, locale])
  @@index([locale, published])
}

enum VitalName {
  LCP
  INP
  CLS
  FCP
  TTFB
}

enum FormFactor {
  mobile
  desktop
}

/// One Core Web Vitals sample from a real visitor (RUM). Lab runs and bots are dropped
/// by the API, so this table is field data only. Reported as p75 per route and metric.
model WebVital {
  id         BigInt     @id @default(autoincrement())
  /// web-vitals metric id; the same metric is re-reported each time the page is hidden,
  /// so reports keep only the latest row per metricId
  metricId   String?
  createdAt  DateTime   @default(now())
  name       VitalName
  value      Float // ms, except CLS (unitless)
  rating     String // good | needs-improvement | poor, as computed by web-vitals
  route      String // route template, e.g. /[locale]/ideas/[room]/[style]
  path       String // concrete URL path, for drilling into a single page
  navigation String // navigate | reload | back-forward | ...
  formFactor FormFactor
  /// Coarse browser family. Google ranks on CrUX (Chrome only, no iOS), and Safari measures
  /// INP differently, so reports keep browsers apart: chrome | edge | firefox | safari | ios | other
  browser    String     @default("other")
  /// INP only: what was interacted with and where the time went
  /// { event, target, startTime, inputDelay, processing, presentation }
  attribution Json?

  @@index([name, route, createdAt])
}
